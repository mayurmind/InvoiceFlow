TEST_DATABASE_URL=postgresql://username:password@host:5432/invoiceflow_test

ACCESS_TOKEN_SECRET=replace-with-secure-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-secure-random-string-at-least-32-chars
CSRF_SECRET=replace-with-secure-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_ISSUER=invoiceflow-api
JWT_AUDIENCE=invoiceflow-web

FRONTEND_URL=http://localhost:3000

